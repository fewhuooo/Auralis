# StudyCore Environment Variables Template
# Copy this file to '.env' and fill in your actual keys.
# DO NOT commit '.env' to git! It is ignored by .gitignore.

# AI Configuration
# DeepSeek API Key (obtained from platform.deepseek.com)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# SiliconFlow API Key (obtained from cloud.siliconflow.cn)
SILICONFLOW_API_KEY=your-siliconflow-api-key-here
