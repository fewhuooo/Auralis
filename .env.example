# Auralis local/container environment template.
# Copy to .env and replace every replace-* value before starting Compose.
# Never commit .env or real provider keys.

# Database
AURALIS_DB_USER=auralis
AURALIS_DB_PASSWORD=replace-with-a-long-random-database-password
AURALIS_DB_NAME=auralis
AURALIS_DB_PORT=5432

# Server and browser origin policy
AURALIS_SERVER_PORT=8080
AURALIS_PUBLIC_BASE_URL=http://localhost:8080
AURALIS_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173,http://tauri.localhost
AURALIS_JWT_SECRET=replace-with-at-least-32-random-bytes-for-jwt
AURALIS_UPLOAD_MAX_FILE_SIZE_BYTES=52428800
# Soft-deleted source recovery window and MinIO cleanup cadence
AURALIS_UPLOAD_ASSET_RETENTION_DAYS=30
AURALIS_UPLOAD_ASSET_CLEANUP_DELAY_MILLIS=3600000
AURALIS_UPLOAD_ASSET_CLEANUP_INITIAL_DELAY_MILLIS=60000

# MinIO
AURALIS_MINIO_ROOT_USER=auralis-minio
AURALIS_MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
AURALIS_MINIO_BUCKET=auralis-assets
AURALIS_MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
AURALIS_MINIO_API_PORT=9000
AURALIS_MINIO_CONSOLE_PORT=9001
AURALIS_MINIO_PRESIGN_TTL_SECONDS=300

# AI runtime defaults. Per-user provider credentials remain encrypted in the database.
AURALIS_AI_ENABLED=false
# Shadow token estimates are diagnostic only; false disables their logs without changing reservations.
AURALIS_AI_SHADOW_TOKEN_ESTIMATE_ENABLED=true
# Overview admission input estimate profile; calibrated-category and mimo-byte-category-candidate are opt-in profiles.
# The MiMo candidate applies only to the exact official endpoint/model and supported CJK prose shapes; other requests use legacy byte estimates.
AURALIS_AI_OVERVIEW_INPUT_TOKEN_ESTIMATOR_MODE=legacy-bytes
# Overview requires an official model profile or an exact server-configured overview-model-capacities entry.
# Spring Boot environment list syntax for a custom profile (set all fields together):
# AURALIS_AI_OVERVIEWMODELCAPACITIES_0_PROVIDER=OPENAI_COMPATIBLE
# AURALIS_AI_OVERVIEWMODELCAPACITIES_0_ENDPOINT=https://provider.example/v1
# AURALIS_AI_OVERVIEWMODELCAPACITIES_0_MODEL=custom-model
# AURALIS_AI_OVERVIEWMODELCAPACITIES_0_CONTEXTWINDOWTOKENS=100000
# AURALIS_AI_OVERVIEWMODELCAPACITIES_0_MAXOUTPUTTOKENS=8000
# The OVERVIEW_MAX_* values below are extra caps; 0 leaves model capacity and quotas dynamic, positive output caps can only lower model maximums.
AURALIS_AI_OVERVIEW_MAX_PROMPT_CHARS=0
AURALIS_AI_OVERVIEW_MAX_REQUEST_BYTES=0
AURALIS_AI_OVERVIEW_MAX_INPUT_TOKENS=0
AURALIS_AI_OVERVIEW_MAX_OUTPUT_TOKENS=0
AURALIS_AI_OVERVIEW_MAX_RESPONSE_BYTES=0
AURALIS_AI_OVERVIEW_MAX_RESULT_CHARS=0
AURALIS_AI_OVERVIEW_MAX_CHECKPOINT_CHARS=0
AURALIS_AI_OVERVIEW_MAX_PLAN_CHARS=0
AURALIS_AI_OVERVIEW_MAX_NODE_DESCRIPTOR_CHARS=0
AURALIS_AI_OVERVIEW_MAX_CHAPTERS=0
AURALIS_AI_OVERVIEW_MAX_SECTIONS=0
AURALIS_AI_OVERVIEW_MAX_PROSE_CHARS=0
AURALIS_AI_OVERVIEW_MAX_GUIDE_ITEMS=0
AURALIS_AI_OVERVIEW_MAX_SOURCE_IDS_PER_SECTION=0
AURALIS_AI_OVERVIEW_MAX_PROVENANCE_SECTIONS=0
AURALIS_AI_OVERVIEW_MAX_PROVENANCE_REFS_PER_SECTION=0
AURALIS_AI_OVERVIEW_MAX_PROVENANCE_REFS=0
AURALIS_AI_OVERVIEW_MAX_PROVENANCE_LOCATIONS=0
AURALIS_AI_OVERVIEW_MAX_WRITER_NODES_PER_PLAN=0
AURALIS_AI_OVERVIEW_MAX_INPUT_SNAPSHOT_CHARS=0
AURALIS_AI_OVERVIEW_MAX_SOURCE_MANIFEST_CHARS=0
AURALIS_AI_OVERVIEW_MAX_JOB_REQUEST_CHARS=0
AURALIS_AI_OVERVIEW_MAX_SOURCES=0
AURALIS_AI_OVERVIEW_MAX_TITLE_CHARS=0
AURALIS_AI_OVERVIEW_MAX_IDENTITY_CHARS=0
AURALIS_AI_OVERVIEW_MAX_PROVENANCE_LOCATIONS_PER_REF=0
AURALIS_AI_INGESTION_WORKER_ENABLED=false
AURALIS_AI_PROVIDER_CONNECT_TIMEOUT_MILLIS=3000
AURALIS_AI_REQUEST_TIMEOUT_MILLIS=10000
AURALIS_AI_OVERVIEW_RESPONSE_TIMEOUT_MILLIS=120000
AURALIS_AI_OVERVIEW_MAX_RETRIES=3
# Direct and durable Overview tasks: 0 disables the overall task deadline.
AURALIS_AI_OVERVIEW_TASK_TIMEOUT_MILLIS=240000
# PC direct Overview SSE wait deadline in milliseconds; 0 disables the PC wait limit.
VITE_OVERVIEW_SSE_DEADLINE_MS=300000
AURALIS_AI_OVERVIEW_ADAPTIVE_GENERATION_ENABLED=false
AURALIS_AI_INGESTION_EMBEDDING_BATCH_MAX_ITEMS=32
AURALIS_AI_INGESTION_EMBEDDING_BATCH_MAX_UTF8_BYTES=32768
# Development safety quotas in tokens; override deliberately for the deployed workload.
AURALIS_AI_LIMITS_GLOBAL_CONCURRENT=4
AURALIS_AI_LIMITS_PER_USER_CONCURRENT=2
AURALIS_AI_LIMITS_PER_USER_HOURLY_TOKENS=1000000
AURALIS_AI_LIMITS_PER_USER_DAILY_TOKENS=2000000
AURALIS_AI_LIMITS_GLOBAL_DAILY_TOKENS=2000000
AURALIS_AI_LIMITS_RESERVATION_LEASE_MILLIS=300000
AURALIS_AI_LIMITS_HEARTBEAT_MILLIS=10000
AURALIS_AI_LIMITS_CHAT_MAX_OUTPUT_TOKENS=4096
AURALIS_AI_LIMITS_CHAT_MAX_CALLS=2
AURALIS_AI_LIMITS_CHAT_TASK_TOKENS=32000
AURALIS_AI_CHAT_AGENT_MAX_MODEL_AND_EMBEDDING_CALLS=8
AURALIS_AI_CHAT_AGENT_MAX_ITERATIONS=8
AURALIS_AI_CHAT_AGENT_MAX_TOOL_CALLS=12
AURALIS_AI_CHAT_AGENT_MAX_TOOL_RESULT_UTF8_BYTES=65536
AURALIS_AI_CHAT_AGENT_MAX_SERIALIZED_REQUEST_UTF8_BYTES=524288
AURALIS_AI_CHAT_AGENT_ATTEMPT_DEADLINE_SECONDS=300
# Overview call quota; 0 means no separate count cap (task/hour/day token quotas still apply).
AURALIS_AI_LIMITS_OVERVIEW_MAX_CALLS=0
AURALIS_AI_LIMITS_OVERVIEW_TASK_TOKENS=524288
AURALIS_AI_LIMITS_INGESTION_MAX_CALLS=512
AURALIS_AI_LIMITS_INGESTION_TASK_TOKENS=16777216
AURALIS_AI_URL_CONNECT_TIMEOUT_MILLIS=3000
AURALIS_AI_URL_READ_TIMEOUT_MILLIS=10000
AURALIS_AI_PROVIDER_MAX_RESPONSE_BYTES=1048576
AURALIS_AI_DEFAULT_PROVIDER=DEEPSEEK
AURALIS_AI_THINKING_ENABLED=false
AURALIS_AI_ALLOWED_PROVIDER_HOSTS=api.deepseek.com,api.openai.com,api.siliconflow.cn
AURALIS_AI_ENCRYPTION_KEY=auralis-ai-key-local-32-bytes!!!

# Optional Overview trace export. Enable only for a controlled manual test.
# Compose tracing overlay enables these for the backend; use these values for JVM/IDE runs.
# AURALIS_OVERVIEW_TRACE_ENABLED=true
# AURALIS_OVERVIEW_TRACE_CAPTURE_CONTENT=true
# AURALIS_OVERVIEW_TRACE_DIRECTORY=D:/Temp/auralis-overview-traces
# AURALIS_OVERVIEW_TRACE_HOST_DIR=D:/Temp/auralis-overview-traces

# Optional provider smoke credentials; keep empty unless an explicit real smoke is being run.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
SILICONFLOW_API_KEY=
AURALIS_AI_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
AURALIS_AI_SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V3
AURALIS_AI_SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
