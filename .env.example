# Auralis local/container environment template.
# Copy to .env and replace every replace-* value before starting Compose.
# Never commit .env or real provider keys.

# Database
AURALIS_DB_USER=auralis
AURALIS_DB_PASSWORD=replace-with-a-long-random-database-password
AURALIS_DB_NAME=auralis
AURALIS_DB_PORT=5432

# Server and browser origin policy
AURALIS_SERVER_PORT=8080
AURALIS_PUBLIC_BASE_URL=http://localhost:8080
AURALIS_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173,http://tauri.localhost
AURALIS_JWT_SECRET=replace-with-at-least-32-random-bytes-for-jwt
AURALIS_UPLOAD_MAX_FILE_SIZE_BYTES=52428800
# Soft-deleted source recovery window and MinIO cleanup cadence
AURALIS_UPLOAD_ASSET_RETENTION_DAYS=30
AURALIS_UPLOAD_ASSET_CLEANUP_DELAY_MILLIS=3600000
AURALIS_UPLOAD_ASSET_CLEANUP_INITIAL_DELAY_MILLIS=60000

# MinIO
AURALIS_MINIO_ROOT_USER=auralis-minio
AURALIS_MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
AURALIS_MINIO_BUCKET=auralis-assets
AURALIS_MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
AURALIS_MINIO_API_PORT=9000
AURALIS_MINIO_CONSOLE_PORT=9001
AURALIS_MINIO_PRESIGN_TTL_SECONDS=300

# AI runtime defaults. Per-user provider credentials remain encrypted in the database.
AURALIS_AI_ENABLED=false
AURALIS_AI_INGESTION_WORKER_ENABLED=false
AURALIS_AI_PROVIDER_CONNECT_TIMEOUT_MILLIS=3000
AURALIS_AI_REQUEST_TIMEOUT_MILLIS=10000
AURALIS_AI_OVERVIEW_RESPONSE_TIMEOUT_MILLIS=120000
AURALIS_AI_URL_CONNECT_TIMEOUT_MILLIS=3000
AURALIS_AI_URL_READ_TIMEOUT_MILLIS=10000
AURALIS_AI_PROVIDER_MAX_RESPONSE_BYTES=1048576
AURALIS_AI_DEFAULT_PROVIDER=DEEPSEEK
AURALIS_AI_ALLOWED_PROVIDER_HOSTS=api.deepseek.com,api.openai.com,api.siliconflow.cn
AURALIS_AI_ENCRYPTION_KEY=auralis-ai-key-local-32-bytes!!!

# Optional provider smoke credentials; keep empty unless an explicit real smoke is being run.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
SILICONFLOW_API_KEY=
AURALIS_AI_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
AURALIS_AI_SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V3
AURALIS_AI_SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
