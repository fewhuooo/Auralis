{
  "name": "auralis-mobile",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "node scripts/vite-build.mjs phone dev",
    "dev:tablet": "node scripts/vite-build.mjs tablet dev",
    "build:phone": "node scripts/vite-build.mjs phone build",
    "build:tablet": "node scripts/vite-build.mjs tablet build",
    "tauri": "tauri",
    "tauri:dev:phone": "tauri dev --config src-tauri/tauri.phone.conf.json",
    "tauri:dev:tablet": "tauri dev --config src-tauri/tauri.tablet.conf.json --config src-tauri/tauri.tablet.desktop.conf.json",
    "android:build:phone": "node scripts/tauri-android-build.mjs phone",
    "android:build:phone:release": "node scripts/tauri-android-build.mjs phone --apk --target aarch64",
    "android:build:tablet": "node scripts/tauri-android-build.mjs tablet",
    "android:build:tablet:release": "node scripts/tauri-android-build.mjs tablet --apk --target aarch64",
    "type-check": "vue-tsc -b",
    "check:r4-mobile": "node scripts/check-r4-mobile.mjs",
    "test:r4-mobile": "node --experimental-strip-types --test scripts/r4-platform.test.mjs scripts/r4-navigation-router.test.mjs scripts/r4-mobile-protocol.test.mjs scripts/r4-device-id-naming.test.mjs scripts/r4-due-review.test.mjs scripts/r4-task-focus.test.mjs scripts/r4-mobile-focus-page.test.mjs scripts/r4-mobile-profile.test.mjs scripts/r4-markdown-math.test.mjs scripts/r4-mobile-ai.test.mjs scripts/r4-local-persistence.test.mjs scripts/r4-tablet-upload-subject.test.mjs src/platform/__tests__/touchFeedback.test.ts",
    "test:tablet": "node --experimental-strip-types scripts/tablet-feature-flags.test.ts && node --experimental-strip-types scripts/tablet-note-model.test.ts && node --experimental-strip-types scripts/tablet-note-repository-core.test.ts"
  },
  "dependencies": {
    "@file-viewer/core": "^2.3.0",
    "@file-viewer/renderer-pdf": "^2.3.0",
    "@file-viewer/renderer-presentation": "^2.3.0",
    "@file-viewer/renderer-word": "^2.3.1",
    "@file-viewer/vite-plugin": "2.3.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.0",
    "@tauri-apps/plugin-haptics": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "dompurify": "^3.4.6",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "marked": "^18.0.5",
    "perfect-freehand": "^1.2.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/katex": "^0.16.8",
    "@types/marked": "^5.0.2",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.0",
    "sass": "^1.100.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vue-tsc": "^3.2.7"
  }
}
