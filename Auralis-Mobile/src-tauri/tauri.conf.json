{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Auralis",
  "version": "0.1.0",
  "identifier": "com.auralis.mobile",
  "build": {
    "beforeDevCommand": "npm run dev:phone",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/vite-build.mjs phone build",
    "frontendDist": "../dist-phone"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Auralis",
        "width": 412,
        "height": 915,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
